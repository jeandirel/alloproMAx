generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================================
// AUTH (NextAuth) — inchange, enrichi de champs internationaux optionnels.
// =========================================================================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("user")
  phone         String?   @unique
  country       String    @default("GA")
  locale        String    @default("fr")
  timezone      String    @default("Africa/Libreville")
  suspended     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ===== Cycle de vie du compte (additif — section account-management) =====
  // active | paused | suspended | deletion_requested | deleted
  accountStatus       String    @default("active")
  pausedAt            DateTime?
  suspendedAt         DateTime?
  suspensionReason    String?   @db.Text
  suspendedById       String?
  deletionRequestedAt DateTime?
  deletionScheduledAt DateTime?
  deletedAt           DateTime?
  // Libellé du provider utilisé à la création du compte (google | phone | credentials) —
  // valeur d'affichage uniquement ; la source de vérité multi-provider reste le modèle Account.
  authProvider        String?
  phoneVerifiedAt     DateTime?
  lastLoginAt         DateTime?

  // Préférences de notification et consentements — booléens simples, cohérents avec le style
  // existant (suspended/online) plutôt qu'un nouveau modèle pour un besoin encore modeste.
  marketingConsent     Boolean @default(false)
  notifyBookingUpdates Boolean @default(true)
  notifyMessages       Boolean @default(true)
  notifySecurity       Boolean @default(true)
  notifyMarketing      Boolean @default(false)

  accounts       Account[]
  sessions       Session[]
  bookings       Booking[]
  addresses      Address[]
  professional   Professional?
  favorites      Favorite[]
  reviewsWritten Review[]
  notifications  Notification[]
  messages       Message[]
  conversations  Conversation[]
  bookingEvents  BookingEvent[]
  disputeEvents  DisputeEvent[]
  disputesRuled  Dispute[]
  reportsFiled   Report[]               @relation("ReportReporter")
  reportsRuled   Report[]               @relation("ReportResolver")
  docsReviewed   ProfessionalDocument[] @relation("DocumentReviewer")
  auditLogs      AuditLog[]
  invoices       Invoice[]

  suspendedBy                 User?          @relation("UserSuspendedBy", fields: [suspendedById], references: [id])
  suspensionsMade             User[]         @relation("UserSuspendedBy")
  professionalSuspensionsMade Professional[] @relation("ProfessionalSuspendedBy")

  locationSuggestionsSubmitted LocationSuggestion[] @relation("LocationSuggestionSubmitter")
  locationSuggestionsReviewed  LocationSuggestion[] @relation("LocationSuggestionReviewer")

  serviceSuggestionsSubmitted ServiceSuggestion[] @relation("ServiceSuggestionSubmitter")
  serviceSuggestionsReviewed  ServiceSuggestion[] @relation("ServiceSuggestionReviewer")

  // Marketplace-transactions (additif) — voir bloc de modeles dedie en fin de fichier.
  serviceRequests            ServiceRequest[]
  contactUnlocksAsClient     ContactUnlock[]
  paymentAttempts            PaymentAttempt[]
  completionProofsSubmitted  CompletionProof[]
  refundsRequested           Refund[]              @relation("RefundRequester")
  refundsDecided             Refund[]              @relation("RefundDecider")
  marketplaceSettingsUpdates MarketplaceSettings[]

  @@index([accountStatus])
  @@index([deletionScheduledAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Stratégie NextAuth restée 'jwt' (voir auth.ts) : un provider Credentials ne passe jamais par le
// chemin "session base de données" de l'adapter, quelle que soit la stratégie configurée — cette
// table est donc gérée à la main dans le callback `jwt`, pas par l'adapter, et sert de source de
// vérité pour "Sécurité → Appareils connectés" (lister/révoquer un appareil, tout déconnecter).
// userAgent/ipAddress/lastUsedAt sont renseignés directement depuis auth.ts.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now()) @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
}

// Investor sandbox: each authenticated user owns an isolated demonstration.
// CONSERVE TEL QUEL : lib/workspace-server.ts, app/api/workspace/route.ts et
// lib/marketplace-engine.ts continuent de lire/ecrire ce modele. La bascule
// vers les tables relationnelles ci-dessous est progressive et separee.
model DemoWorkspace {
  id        String   @id @default(cuid())
  userId    String   @unique
  state     Json
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Stockage S3 reel (presigned URLs). Reutilise comme backing store pour les
// documents KYC, la galerie professionnelle, les photos de reservation et
// les preuves de litige — pas de systeme de fichiers parallele.
model UploadedAsset {
  id                 String   @id @default(cuid())
  userId             String
  cloud_storage_path String   @unique
  isPublic           Boolean  @default(false)
  name               String
  contentType        String
  size               Int
  complete           Boolean  @default(false)
  createdAt          DateTime @default(now())

  document                 ProfessionalDocument?
  bookingAsset             BookingAsset?
  disputeEvidence          DisputeEvidence?
  invoice                  Invoice?
  serviceRequestAttachment ServiceRequestAttachment?

  @@index([userId])
}

// Durable journal; a new attempt is allowed only after a confirmed failure.
// Modele de reference (verrouillage SQL, idempotence, machine a etats).
// GARDE TEL QUEL : pas de FK stricte sur missionId tant que la bascule du
// flux JSON vers Booking n'est pas faite (les IDs de mission actuels ne
// correspondent pas encore a de vraies lignes Booking).
model PaymentTransaction {
  id          String    @id
  userId      String
  missionId   String
  kind        String
  attempt     Int
  mode        String
  status      String    @default("CREATED")
  amount      Int
  currency    String    @default("XAF")
  provider    String
  phoneNumber String
  depositId   String?
  failureCode String?
  checkedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, missionId, kind, attempt])
}

model DemoOtp {
  id        String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
}

// Authentification téléphone RÉELLE (production) — distincte de DemoOtp ci-dessus qui reste la
// simulation investisseur (aucun SMS, compte aléatoire à chaque essai). Ce modèle porte le numéro
// et alimente le CredentialsProvider('phone') dans auth.ts : find-or-create d'un vrai User par
// numéro normalisé E.164.
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

// =========================================================================
// CATALOGUE RELATIONNEL (remplace le clonage de lib/data.ts par utilisateur)
// =========================================================================

model Address {
  id             String   @id @default(cuid())
  userId         String
  label          String?
  line1          String
  line2          String?
  quartier       String?
  city           String   @default("Libreville")
  region         String?
  postalCode     String?
  country        String   @default("GA")
  lat            Float?
  lng            Float?
  isDefault      Boolean  @default(false)
  provinceId     String?
  cityId         String?
  neighborhoodId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  province     Province?     @relation(fields: [provinceId], references: [id])
  cityRef      City?         @relation(fields: [cityId], references: [id])
  neighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  @@index([userId])
  @@index([provinceId])
  @@index([cityId])
  @@index([neighborhoodId])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  icon        String?
  description String?  @db.Text
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Override de commission plateforme pour cette categorie (marketplace-transactions) — null =
  // herite de MarketplaceSettings.platformCommissionBps. Resolu par lib/marketplace/settings.ts.
  commissionBpsOverride Int?

  professionals Professional[]
  services      Service[]
  bookings      Booking[]

  // Catalogue de services (taxonomie) — additif, distinct des Service
  // ci-dessus qui restent des annonces individuelles de professionnels.
  subcategories      ServiceSubcategory[]
  catalogServices    CatalogService[]
  serviceSuggestions ServiceSuggestion[]
  serviceRequests    ServiceRequest[]
}

model Professional {
  id             String   @id @default(cuid())
  userId         String   @unique
  categoryId     String
  headline       String?
  bio            String?  @db.Text
  zone           String?
  zones          String[]
  provinceId     String?
  cityId         String?
  neighborhoodId String?
  experience     Int      @default(0)
  ratingAvg      Float    @default(0)
  ratingCount    Int      @default(0)
  responseRate   Int?
  avgReplyTime   String?
  availability   String?
  online         Boolean  @default(false)
  priceFrom      Int      @default(0)
  photo          String?
  gallery        String[]
  kycStatus      String   @default("brouillon") // brouillon | en_cours | verifie | refuse
  kycReason      String?  @db.Text
  suspended      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ===== Cycle de vie de l'activité professionnelle (additif) =====
  // Distinct de kycStatus (vérification d'identité) et de `suspended` (déjà existant, imposé par
  // un admin) : `paused` est une mise en pause VOLONTAIRE par le professionnel lui-même — masque
  // le profil des résultats publics sans toucher au compte utilisateur ni à l'historique.
  paused           Boolean   @default(false)
  pausedAt         DateTime?
  suspendedAt      DateTime?
  suspensionReason String?   @db.Text
  suspendedById    String?
  // Suppression du PROFIL professionnel uniquement (distinct de User.deletedAt qui supprime tout
  // le compte) — conserve la ligne pour préserver reviews/bookings/payouts existants (FK Restrict).
  deletedAt        DateTime?

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  suspendedBy   User?                  @relation("ProfessionalSuspendedBy", fields: [suspendedById], references: [id])
  category      Category               @relation(fields: [categoryId], references: [id])
  services      Service[]
  documents     ProfessionalDocument[]
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
  conversations Conversation[]
  payouts       Payout[]
  province      Province?              @relation(fields: [provinceId], references: [id])
  city          City?                  @relation(fields: [cityId], references: [id])
  neighborhood  Neighborhood?          @relation(fields: [neighborhoodId], references: [id])

  // Catalogue de services (taxonomie) — liste des CatalogService que ce
  // professionnel propose, distincte de `services` (annonces Service ci-dessus).
  professionalServices ProfessionalService[]

  // Marketplace-transactions (additif) — voir bloc de modeles dedie en fin de fichier.
  offers         Offer[]
  contactUnlocks ContactUnlock[]

  @@index([categoryId])
  @@index([online])
  @@index([ratingAvg])
  @@index([categoryId, ratingAvg])
  @@index([zone])
  @@index([provinceId])
  @@index([cityId])
  @@index([neighborhoodId])
  @@index([paused])
  @@index([deletedAt])
}

model Service {
  id             String   @id @default(cuid())
  professionalId String
  categoryId     String
  name           String
  price          Int
  active         Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Pont de migration progressive : lie optionnellement cette annonce
  // (nom libre + tarif) a une feuille de la taxonomie normalisee
  // (CatalogService). Nullable pour ne pas casser les annonces existantes ;
  // le rattachement se fait progressivement (cf. rapport Phase services).
  catalogServiceId String?

  professional   Professional    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id])
  catalogService CatalogService? @relation(fields: [catalogServiceId], references: [id])
  bookings       Booking[]

  @@unique([professionalId, name])
  @@index([professionalId])
  @@index([catalogServiceId])
}

// Documents KYC — reutilise UploadedAsset (S3), ajoute statut + tracabilite.
model ProfessionalDocument {
  id             String    @id @default(cuid())
  professionalId String
  type           String // recto | verso | casier | portrait | realisation
  assetId        String    @unique
  status         String    @default("en_attente") // en_attente | valide | refuse
  reviewedById   String?
  reviewedAt     DateTime?
  reviewReason   String?   @db.Text
  createdAt      DateTime  @default(now())

  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  asset          UploadedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reviewedBy     User?         @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  retentionUntil DateTime?

  @@index([professionalId])
  @@index([type])
}

// =========================================================================
// RESERVATION — remplace la Mission JSON. Reprend le modele Booking
// existant (mort en code) comme le VRAI modele relationnel.
// =========================================================================
model Booking {
  id             String    @id @default(cuid())
  code           String    @unique
  userId         String
  professionalId String
  serviceId      String?
  categoryId     String
  addressId      String?
  description    String?   @db.Text
  address        String // snapshot fige au moment de la reservation, distinct d'addressRef (carnet d'adresses mutable)
  quartier       String
  neighborhoodId String?
  accessNotes    String?   @db.Text
  date           DateTime
  urgent         Boolean   @default(false)
  status         String    @default("en_attente")
  basePrice      Int
  serviceFee     Int
  totalPrice     Int
  paymentMethod  String?
  paymentNumber  String?
  paymentStatus  String    @default("a_payer")
  requestKey     String?   @unique
  reportText     String?   @db.Text // signalement rapide inline, distinct du modele Report/Dispute structure
  deadline       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Pont marketplace-transactions (additif) — renseigne uniquement pour les reservations issues
  // du flux ServiceRequest -> Offer -> acceptation (negociation reelle), jamais pour les demandes
  // directes existantes (serviceId). offerSnapshotId fige les montants au moment de l'acceptation :
  // une modification ulterieure de MarketplaceSettings ne doit jamais changer cette reservation.
  serviceRequestId String? @unique
  offerId          String? @unique
  offerSnapshotId  String? @unique

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service      Service?      @relation(fields: [serviceId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  addressRef   Address?      @relation(fields: [addressId], references: [id])
  neighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id])

  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  offer          Offer?          @relation(fields: [offerId], references: [id])
  offerSnapshot  OfferSnapshot?  @relation(fields: [offerSnapshotId], references: [id])

  events          BookingEvent[]
  assets          BookingAsset[]
  dispute         Dispute?
  review          Review?
  payout          Payout?
  invoice         Invoice?
  conversation    Conversation?
  paymentAttempts PaymentAttempt[]
  ledgerEntries   LedgerEntry[]
  completionProof CompletionProof?
  refunds         Refund[]

  @@index([userId, status, date])
  @@index([professionalId, status, date])
  @@index([status])
  @@index([date])
  @@index([neighborhoodId])
}

// Fichiers lies a une reservation (demande initiale, avant/apres intervention).
model BookingAsset {
  id        String   @id @default(cuid())
  bookingId String
  assetId   String
  kind      String // request | before | after
  createdAt DateTime @default(now())

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  asset   UploadedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId])
  @@index([bookingId])
}

// Journal d'audit simplifie remplaçant le tableau events[] en texte libre.
model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  actorId   String?
  actorRole String // client | professionnel | administrateur | system
  type      String
  message   String   @db.Text
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([bookingId])
}

// Un seul avis par reservation validee/payee.
model Review {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  professionalId String
  authorId       String
  quality        Int
  punctuality    Int
  communication  Int
  comment        String?  @db.Text
  hidden         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

// Litige avec historique/tracabilite structuree (remplace le champ mutable).
model Dispute {
  id             String    @id @default(cuid())
  bookingId      String    @unique
  reason         String    @db.Text
  status         String    @default("ouvert") // ouvert | resolu
  decision       String? // refund | release
  decisionReason String?   @db.Text
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  booking    Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resolvedBy User?             @relation(fields: [resolvedById], references: [id])
  evidence   DisputeEvidence[]
  events     DisputeEvent[]

  @@index([status])
}

model DisputeEvidence {
  id        String   @id @default(cuid())
  disputeId String
  assetId   String   @unique
  createdAt DateTime @default(now())

  dispute Dispute       @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  asset   UploadedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model DisputeEvent {
  id        String   @id @default(cuid())
  disputeId String
  actorId   String?
  actorRole String
  message   String   @db.Text
  createdAt DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([disputeId])
}

// Messagerie — un fil par reservation (comme l'ancien thread par missionId).
// Un meme couple client/pro peut avoir plusieurs fils s'il rebooke.
model Conversation {
  id             String   @id @default(cuid())
  bookingId      String?  @unique
  clientId       String
  professionalId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  booking      Booking?     @relation(fields: [bookingId], references: [id])
  client       User         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([clientId, professionalId])
  @@index([professionalId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  authorId       String
  authorRole     String
  body           String    @db.Text
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([conversationId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  role      String
  proId     String?
  text      String   @db.Text
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// Favori unique par paire utilisateur/professionnel.
model Favorite {
  id             String   @id @default(cuid())
  userId         String
  professionalId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([userId, professionalId])
}

// Signalement — distinct du litige (peut cibler un profil, un avis, un message).
model Report {
  id           String    @id @default(cuid())
  reporterId   String?
  targetType   String // professional | booking | review | message
  targetId     String
  reason       String    @db.Text
  status       String    @default("ouvert") // ouvert | resolu
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  reporter   User? @relation("ReportReporter", fields: [reporterId], references: [id])
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([targetType, targetId])
}

// Versement au professionnel — distinct de la transaction de paiement client.
model Payout {
  id             String    @id @default(cuid())
  professionalId String
  bookingId      String?   @unique
  amount         Int
  currency       String    @default("XAF")
  status         String    @default("a_verser") // a_verser | verse | echoue
  provider       String?
  phoneNumber    String?
  transactionRef String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Marketplace-transactions (additif) — frais reel preleve par le PSP sur ce versement, connu
  // seulement au traitement (jamais devine a l'avance). amount ci-dessus reste le net verse ;
  // grossAmount/platformFeeAmount viennent de l'OfferSnapshot fige, providerFeeActual vient du PSP.
  // Les tentatives de versement elles-memes sont des PaymentAttempt(bookingId, kind='payout') —
  // pas de pointeur direct ici, meme logique que Booking qui n'en a pas non plus.
  providerFeeActual Int? @default(0)

  professional  Professional  @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  booking       Booking?      @relation(fields: [bookingId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([professionalId])
  @@index([status])
}

// Facture avec numerotation sequentielle (ex. INV-2026-000001).
model Invoice {
  id         String   @id @default(cuid())
  number     String   @unique
  bookingId  String   @unique
  userId     String
  amount     Int
  commission Int
  currency   String   @default("XAF")
  issuedAt   DateTime @default(now())
  pdfAssetId String?  @unique

  booking  Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  pdfAsset UploadedAsset? @relation(fields: [pdfAssetId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([createdAt])
}

// Configuration plateforme — ligne unique (id fixe = 1).
model PlatformSettings {
  id         Int      @id @default(1)
  commission Float    @default(12)
  autoHours  Int      @default(48)
  updatedAt  DateTime @updatedAt
}

// =========================================================================
// LOCALISATION GABON (province -> ville -> quartier) — catalogue normalise
// alimente par prisma/seed-data/gabon-locations.json (scripts/import-locations.ts).
// Additif uniquement : les champs zone/zones (Professional), quartier/city/region
// (Address, Booking) en texte libre restent inchanges et continuent de fonctionner.
// =========================================================================

model Province {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  normalizedName String   @unique
  countryCode    String   @default("GA")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cities        City[]
  professionals Professional[]
  addresses     Address[]
  suggestions   LocationSuggestion[]

  @@index([countryCode])
}

model City {
  id             String   @id @default(cuid())
  provinceId     String
  name           String
  slug           String
  normalizedName String
  isActive       Boolean  @default(true)
  source         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  province      Province             @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  neighborhoods Neighborhood[]
  professionals Professional[]
  addresses     Address[]
  suggestions   LocationSuggestion[]

  @@unique([provinceId, normalizedName])
  @@index([provinceId])
  @@index([slug])
}

model Neighborhood {
  id             String   @id @default(cuid())
  cityId         String
  name           String
  slug           String
  normalizedName String
  isActive       Boolean  @default(true)
  source         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  city          City           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  professionals Professional[]
  addresses     Address[]
  bookings      Booking[]

  // Marketplace-transactions (additif) — voir bloc de modeles dedie en fin de fichier.
  serviceRequests ServiceRequest[]

  @@unique([cityId, normalizedName])
  @@index([cityId])
  @@index([slug])
  @@index([normalizedName])
}

model LocationSuggestion {
  id             String    @id @default(cuid())
  type           String // CITY | NEIGHBORHOOD
  provinceId     String?
  cityId         String?
  proposedName   String
  normalizedName String
  extraInfo      String?   @db.Text
  submittedBy    String?
  submitterEmail String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminComment   String?   @db.Text
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  province  Province? @relation(fields: [provinceId], references: [id])
  city      City?     @relation(fields: [cityId], references: [id])
  submitter User?     @relation("LocationSuggestionSubmitter", fields: [submittedBy], references: [id])
  reviewer  User?     @relation("LocationSuggestionReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([type, status])
  @@index([normalizedName])
}

// =========================================================================
// CATALOGUE DE SERVICES (Categorie -> Sous-categorie -> Service) — catalogue
// normalise alimente par prisma/seed-data/services-catalogue.json
// (scripts/import-catalogue.ts).
//
// IMPORTANT : le modele `Service` existant (ci-dessus) reste une ANNONCE
// individuelle d'un professionnel (professionalId + price + reference par
// Booking) — ce n'est PAS une feuille de taxonomie. Pour eviter toute
// collision de nom/semantique, la feuille de taxonomie est un nouveau modele
// `CatalogService`. Le pont progressif entre les deux est le champ optionnel
// `Service.catalogServiceId` ajoute ci-dessus.
//
// Additif uniquement : Category est reutilisee et etendue (description +
// nouvelles back-relations), rien n'est renomme ni supprime.
// =========================================================================

model ServiceSubcategory {
  id             String   @id @default(cuid())
  categoryId     String
  name           String
  slug           String
  normalizedName String
  description    String?  @db.Text
  icon           String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Override de commission plateforme pour cette sous-categorie (marketplace-transactions) —
  // priorite sur Category.commissionBpsOverride ; null = herite du niveau categorie/global.
  commissionBpsOverride Int?

  category        Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  services        CatalogService[]
  suggestions     ServiceSuggestion[]
  serviceRequests ServiceRequest[]

  @@unique([categoryId, normalizedName])
  @@index([categoryId])
}

// Feuille de taxonomie (ex. Plomberie -> "Debouchage canalisation"), distincte
// du modele `Service` (annonce payante d'un professionnel).
model CatalogService {
  id             String   @id @default(cuid())
  categoryId     String
  subcategoryId  String
  name           String
  slug           String
  normalizedName String
  description    String?  @db.Text
  keywords       String[]
  synonyms       String[]
  searchCount    Int      @default(0) // best-effort, incremente seulement quand un utilisateur choisit ce resultat
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category       Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory    ServiceSubcategory    @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  professionals  ProfessionalService[]
  legacyServices Service[]

  // Marketplace-transactions (additif) — voir bloc de modeles dedie en fin de fichier.
  serviceRequests ServiceRequest[]

  @@unique([subcategoryId, normalizedName])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([slug])
}

// Liaison many-to-many Professionnel <-> CatalogService (le professionnel
// "propose" une feuille de taxonomie, independamment de ses annonces Service
// existantes qui portent leur propre prix/description libres).
model ProfessionalService {
  id             String   @id @default(cuid())
  professionalId String
  serviceId      String // FK vers CatalogService (nom de champ impose par la spec produit)
  isActive       Boolean  @default(true)
  priceFrom      Int?
  priceType      String?
  description    String?  @db.Text
  createdAt      DateTime @default(now())

  professional Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      CatalogService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@index([professionalId])
  @@index([serviceId])
}

model ServiceSuggestion {
  id             String    @id @default(cuid())
  proposedName   String
  normalizedName String
  categoryId     String?
  subcategoryId  String?
  description    String?   @db.Text
  submittedBy    String?
  submitterEmail String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminComment   String?   @db.Text
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category    Category?           @relation(fields: [categoryId], references: [id])
  subcategory ServiceSubcategory? @relation(fields: [subcategoryId], references: [id])
  submitter   User?               @relation("ServiceSuggestionSubmitter", fields: [submittedBy], references: [id])
  reviewer    User?               @relation("ServiceSuggestionReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([normalizedName])
}

// =========================================================================
// MARKETPLACE TRANSACTIONS (additif) — negociation reelle ServiceRequest -> Offer
// -> Booking, deblocage de contact, paiements/versements reels pawaPay, grand
// livre append-only. Entierement distinct du parcours demo investisseur
// (DemoWorkspace / Mission JSON / PaymentTransaction ci-dessus, CONSERVE TEL
// QUEL) : ce bloc alimente les VRAIS User/Professional/Booking relationnels.
//
// Principes (voir lib/marketplace/*) :
// - Tous les montants sont des entiers (FCFA), toutes les commissions des
//   entiers en points de base (1 bps = 0.01 %), jamais de float financier.
// - Offer est immuable et versionnee : une renegociation cree une nouvelle
//   ligne (version+1, previousOfferId), jamais une mutation du montant.
// - OfferSnapshot fige les montants au moment de l'acceptation ; une
//   modification ulterieure de MarketplaceSettings ne retroagit jamais.
// - LedgerEntry est append-only (aucun code ne l'update ni ne le supprime).
// =========================================================================

// Configuration financiere de la plateforme — ligne unique (id fixe = 1),
// distincte de PlatformSettings (commission en float, parcours demo) :
// commission en points de base, entiers uniquement.
model MarketplaceSettings {
  id                     Int      @id @default(1)
  platformCommissionBps  Int      @default(700) // 7% par defaut
  contactUnlockFeeAmount Int      @default(500) // FCFA, prix par defaut d'un deblocage de contact
  currency               String   @default("XAF")
  version                Int      @default(1) // incremente a chaque modification, tracabilite uniquement
  updatedAt              DateTime @updatedAt
  updatedById            String?

  updatedBy User? @relation(fields: [updatedById], references: [id])
}

// Demande de service publiee par un client — point d'entree de la
// negociation reelle (distincte de Service.select, qui reste une reservation
// directe immediate sur une annonce existante).
model ServiceRequest {
  id               String    @id @default(cuid())
  clientId         String
  categoryId       String
  subcategoryId    String?
  catalogServiceId String?
  title            String
  description      String    @db.Text
  address          String?
  quartier         String?
  neighborhoodId   String?
  budgetMinAmount  Int?
  budgetMaxAmount  Int?
  urgent           Boolean   @default(false)
  preferredDate    DateTime?
  status           String    @default("draft") // draft | open | negotiating | awarded | closed | expired | cancelled
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client         User                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category       Category            @relation(fields: [categoryId], references: [id])
  subcategory    ServiceSubcategory? @relation(fields: [subcategoryId], references: [id])
  catalogService CatalogService?     @relation(fields: [catalogServiceId], references: [id])
  neighborhood   Neighborhood?       @relation(fields: [neighborhoodId], references: [id])

  attachments ServiceRequestAttachment[]
  offers      Offer[]
  booking     Booking?

  @@index([clientId, status])
  @@index([categoryId, status])
  @@index([status])
  @@index([expiresAt])
}

// Fichiers joints a une demande (photos du probleme a resoudre, plans...).
model ServiceRequestAttachment {
  id               String   @id @default(cuid())
  serviceRequestId String
  assetId          String   @unique
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  asset          UploadedAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}

// Proposition d'un professionnel sur une demande. IMMUABLE : une renegociation
// (nouveau montant/message) cree une nouvelle ligne (version+1, previousOfferId)
// au lieu de modifier amount/message sur la ligne existante ; seul `status`
// est mute (transitions validees par lib/marketplace/state-machine.ts).
model Offer {
  id               String    @id @default(cuid())
  serviceRequestId String
  professionalId   String
  version          Int       @default(1)
  previousOfferId  String?   @unique
  amount           Int
  message          String?   @db.Text
  status           String    @default("pending") // pending | accepted | rejected | withdrawn | expired | superseded
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  professional   Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  previousOffer  Offer?         @relation("OfferRevision", fields: [previousOfferId], references: [id])
  nextOffer      Offer?         @relation("OfferRevision")
  snapshot       OfferSnapshot?
  booking        Booking?

  @@index([serviceRequestId, status])
  @@index([professionalId, status])
}

// Photographie financiere immuable prise au moment de l'acceptation d'une
// Offer — seule source de verite pour les montants d'une reservation issue de
// la negociation reelle, jamais recalculee apres coup.
model OfferSnapshot {
  id                    String   @id @default(cuid())
  offerId               String   @unique
  grossAmount           Int
  currency              String   @default("XAF")
  platformCommissionBps Int
  platformFeeAmount     Int
  professionalNetAmount Int
  settingsVersion       Int
  createdAt             DateTime @default(now())

  offer   Offer    @relation(fields: [offerId], references: [id], onDelete: Restrict)
  booking Booking?

  @@index([offerId])
}

// Deblocage payant des coordonnees d'un professionnel par un client, avant
// toute reservation. Feature-flagge par CONTACT_UNLOCK_ENABLED (lib/marketplace/flags.ts).
model ContactUnlock {
  id             String    @id @default(cuid())
  clientId       String
  professionalId String
  amount         Int
  currency       String    @default("XAF")
  status         String    @default("pending") // pending | paid | failed | refunded
  unlockedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client          User             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional    Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  paymentAttempts PaymentAttempt[]
  ledgerEntries   LedgerEntry[]

  @@index([clientId, professionalId])
  @@index([professionalId, status])
}

// Tentative de paiement/versement/remboursement REEL pawaPay, ratachee a une
// vraie Booking ou a un ContactUnlock (jamais aux deux). Distinct de
// PaymentTransaction (demo, missionId JSON) meme forme de champs pour
// reutiliser lib/pawapay.ts sans dupliquer sa logique.
model PaymentAttempt {
  id              String    @id
  userId          String
  bookingId       String?
  contactUnlockId String?
  kind            String // deposit | payout | refund
  attempt         Int
  mode            String // sandbox | production — jamais 'mock' ici (reserve au parcours demo)
  status          String    @default("CREATED")
  amount          Int
  currency        String    @default("XAF")
  provider        String
  phoneNumber     String
  depositId       String? // encaissement source, pour un refund
  failureCode     String?
  checkedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking       Booking?       @relation(fields: [bookingId], references: [id])
  contactUnlock ContactUnlock? @relation(fields: [contactUnlockId], references: [id])

  providerEvents PaymentProviderEvent[]
  ledgerEntries  LedgerEntry[]

  @@unique([bookingId, kind, attempt])
  @@unique([contactUnlockId, kind, attempt])
  @@index([status])
  @@index([userId])
}

// Journal des evenements/callbacks recus d'un PSP (pawaPay) — idempotence via
// (provider, providerEventId) : une meme livraison repetee d'un webhook ne
// produit jamais de double effet. providerEventId est construit par notre
// code (ex. `${referenceId}:${status}`), pas fourni tel quel par pawaPay.
model PaymentProviderEvent {
  id               String   @id @default(cuid())
  provider         String // pawapay
  providerEventId  String
  paymentAttemptId String?
  payload          Json?
  receivedAt       DateTime @default(now())

  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])

  @@unique([provider, providerEventId])
  @@index([paymentAttemptId])
}

// Grand livre financier append-only — jamais mis a jour ni supprime par le
// code applicatif. Une ligne par mouvement (commission plateforme, versement
// professionnel, remboursement, frais de deblocage de contact, frais PSP reel).
model LedgerEntry {
  id               String   @id @default(cuid())
  bookingId        String?
  contactUnlockId  String?
  payoutId         String?
  paymentAttemptId String?
  type             String // platform_fee | professional_payout | refund | contact_unlock_fee | provider_fee_actual
  amount           Int // signe : positif = entrant plateforme, negatif = sortant
  currency         String   @default("XAF")
  description      String?  @db.Text
  createdAt        DateTime @default(now())

  booking        Booking?        @relation(fields: [bookingId], references: [id])
  contactUnlock  ContactUnlock?  @relation(fields: [contactUnlockId], references: [id])
  payout         Payout?         @relation(fields: [payoutId], references: [id])
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])

  @@index([bookingId])
  @@index([contactUnlockId])
  @@index([type])
  @@index([createdAt])
}

// Preuve de fin d'intervention soumise par le professionnel — declenche le
// delai de validation automatique (auto-completion) si le client ne reagit pas.
// Les fichiers eux-memes reutilisent BookingAsset (kind = 'completion_proof').
model CompletionProof {
  id                   String    @id @default(cuid())
  bookingId            String    @unique
  submittedById        String
  autoCompleteDeadline DateTime
  clientConfirmedAt    DateTime?
  autoCompletedAt      DateTime?
  createdAt            DateTime  @default(now())

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  submittedBy User    @relation(fields: [submittedById], references: [id])

  @@index([autoCompleteDeadline])
}

// Demande de remboursement au niveau metier — distincte de la tentative de
// paiement PaymentAttempt(kind='refund') qui l'execute reellement une fois
// approuvee.
model Refund {
  id             String    @id @default(cuid())
  bookingId      String
  requestedById  String
  reason         String    @db.Text
  amount         Int
  status         String    @default("requested") // requested | approved | rejected | processing | completed | failed
  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  requestedBy User    @relation("RefundRequester", fields: [requestedById], references: [id])
  decidedBy   User?   @relation("RefundDecider", fields: [decidedById], references: [id])

  @@index([bookingId])
  @@index([status])
}

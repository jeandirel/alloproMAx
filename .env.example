DATABASE_URL="postgresql://user:password@host:5432/dbname?connect_timeout=15"
NEXTAUTH_SECRET=""
AUTH_SECRET=""
# URL publique du déploiement (metadataBase, sitemap.ts, robots.ts).
NEXTAUTH_URL=""
AWS_PROFILE=""
AWS_REGION=""
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""
# Mettre à "false" avant toute ouverture réelle : désactive les identités demo-admin/demo-otp
# (aucune vérification) et la restitution en clair du code OTP simulé. Par défaut : activé.
ALLOW_DEMO_AUTH=""

# pawaPay (paiements mobile money)
PAWAPAY_ENVIRONMENT="sandbox"
PAWAPAY_API_TOKEN=""
# Secret partagé pour authentifier les callbacks entrants pawaPay (Authorization: Bearer <token>).
# Non vérifié tant que ce schéma n'est pas confirmé contre la vraie documentation marchand pawaPay.
# Si laissé vide, aucune vérification n'est appliquée (comportement actuel, non sécurisé).
PAWAPAY_CALLBACK_SECRET=""

# KYC/IDV — vérification d'identité des professionnels (Phase 2)
# "manual" (défaut, aucune vérification automatisée) | "onfido" | "smile_identity"
KYC_PROVIDER="manual"
ONFIDO_API_TOKEN=""
SMILE_IDENTITY_PARTNER_ID=""
SMILE_IDENTITY_API_KEY=""
